# AI-Powered Personal Farming Assistant Configuration

# Application
APP_NAME="AI-Powered Personal Farming Assistant"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api"

# Security / JWT
SECRET_KEY="farming-assistant-super-secret-key-change-in-production-btech-project"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# PostgreSQL connection string example: postgresql://postgres:postgres@localhost:5432/farming_db
# SQLite fallback is supported if PostgreSQL is not locally installed: sqlite:///./farming.db
DATABASE_URL="sqlite:///./farming.db"

# LLM / AI Chatbot
# Optional: Set Google Gemini API Key or HuggingFace key. If blank, the system uses the intelligent local agronomy RAG engine.
GEMINI_API_KEY=""

# External APIs
WEATHER_API_URL="https://api.open-meteo.com/v1/forecast"

# Uploads
UPLOAD_DIR="static/uploads"
MAX_IMAGE_SIZE_MB=10

# ML Models
MODEL_DIR="app/ml/saved_models"
DISEASE_CONFIDENCE_THRESHOLD=0.60
